# Routes
# This file defines all application routes (Higher priority routes first)
# ~~~~

# An example controller showing a sample home page
GET     /                           controllers.HomeController.index()

# Map static resources from the /public folder to the /assets URL path
GET     /assets/*file               controllers.Assets.versioned(path="/public", file: Asset)

# Health check endpoint
GET     /health                     controllers.HealthController.health()

# OAuth/OIDC endpoints
GET     /auth/login                 controllers.AuthController.login(request: Request)
GET     /oauth/complete             controllers.AuthController.callback(code: String, state: String, request: Request)
POST    /auth/logout                controllers.AuthController.logout(request: Request)
GET     /api/me                     controllers.AuthController.me(request: Request)
GET     /api/secure                 controllers.AuthController.secure(request: Request)