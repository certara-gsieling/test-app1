{
  "name": "new-module2-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "jest",
    "postinstall": "node scripts/copy-certara-ui.js",
    "screenshot": "node scripts/screenshot.js",
    "watch:screenshots": "chokidar \"src/**/*\" \"app/views/**/*\" -c \"npm run build && npm run screenshot\"",
    "oauth:test": "node scripts/oauth-login.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:prod": "cross-env NODE_ENV=production eslint .",
    "lint:java": "java -jar tools/checkstyle.jar -c checkstyle.xml app/ test/",
    "test:pw": "playwright test",
    "test:pw:headed": "playwright test --headed",
    "report": "playwright show-report",
    "allure:generate": "allure generate --clean test-reports/allure-results -o test-reports/allure-report",
    "allure:open": "allure open test-reports/allure-report"
  },
  "dependencies": {
    "@certara/certara-ui": "^0.3.22",
    "@certara/certara-ui-react": "^0.3.22",
    "@reduxjs/toolkit": "^2.2.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-redux": "^9.2.0",
    "react-router-dom": "^7.9.5",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.25.4",
    "@babel/preset-react": "^7.24.7",
    "@playwright/test": "^1.56.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.6.1",
    "@vitejs/plugin-react": "^4.3.3",
    "allure-commandline": "^2.34.1",
    "allure-playwright": "^3.4.2",
    "babel-jest": "^29.7.0",
    "chokidar-cli": "^3.0.0",
    "cross-env": "^7.0.3",
    "eslint": "^9.14.0",
    "eslint-plugin-react": "^7.37.2",
    "globals": "^16.4.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "playwright": "^1.48.2",
    "vite": "^5.4.7"
  }
}
